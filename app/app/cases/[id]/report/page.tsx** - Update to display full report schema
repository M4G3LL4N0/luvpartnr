import { redirect } from "next/navigation";
import { createClient } from "@/lib/supabase/server";
import GenerateReportButton from "./report-button";

export default async function CaseReportPage({
  params,
}: {
  params: Promise<{ id: string }>;
}) {
  const { id } = await params;
  const supabase = await createClient();

  const {
    data: { user },
  } = await supabase.auth.getUser();

  if (!user) redirect("/login");

  const { data: latestReport } = await supabase
    .from("reports")
    .select("*")
    .eq("case_file_id", id)
    .order("created_at", { ascending: false })
    .limit(1)
    .maybeSingle();

  const reportData = latestReport?.report_json as {
    observedFacts?: string[];
    strongInferences?: string[];
    weakInferences?: string[];
    missingInformation?: string[];
    redFlags?: string[];
    greenFlags?: string[];
    nextSteps?: string[];
    longTermOutlook?: {
      oneYear: string;
      fiveYears: string;
      twentyYears: string;
    };
    scores?: {
      trustworthiness: number;
      emotionalMaturity: number;
      consistency: number;
      compatibility: number;
      communicationQuality: number;
      relationshipRisk: number;
    };
  };

  return (
    <main className="min-h-screen bg-black px-6 py-20 text-white">
      <div className="mx-auto max-w-6xl">
        <div className="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-8">
          <div>
            <div className="text-xs uppercase tracking-[0.2em] text-zinc-400">Report</div>
            <h1 className="mt-4 text-4xl font-semibold">Relationship intelligence report</h1>
          </div>
          <GenerateReportButton caseFileId={id} />
        </div>

        {!latestReport ? (
          <div className="mt-10 rounded-3xl border border-white/10 bg-white/5 p-8 text-zinc-400">
            No report yet. Generate your first mock report.
          </div>
        ) : (
          <div className="space-y-8">
            {latestReport.summary && (
              <section className="rounded-3xl border border-white/10 bg-white/5 p-8">
                <h2 className="text-2xl font-semibold">Executive Summary</h2>
                <p className="mt-4 text-zinc-300 leading-relaxed">{latestReport.summary}</p>
              </section>
            )}

            {reportData.scores && (
              <section>
                <h2 className="text-2xl font-semibold mb-4">Score Cards</h2>
                <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                  {Object.entries(reportData.scores).map(([key, value]) => (
                    <div key={key} className="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
                      <div className="text-xs uppercase tracking-wider text-zinc-500 mb-2">
                        {key.replace(/([A-Z])/g, ' $1').trim()}
                      </div>
                      <div className="text-2xl font-bold">{value}</div>
                    </div>
                  ))}
                </div>
              </section>
            )}

            <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
              <div className="space-y-6">
                {reportData.observedFacts && reportData.observedFacts.length > 0 && (
                  <section className="rounded-3xl border border-white/10 bg-white/5 p-6">
                    <h2 className="text-xl font-semibold mb-4 flex items-center">
                      <span className="w-2 h-2 bg-blue-500 rounded-full mr-3"></span>
                      Observed Facts
                    </h2>
                    <ul className="space-y-2">
                      {reportData.observedFacts.map((fact, index) => (
                        <li key={index} className="text-zinc-300 flex items-start">
                          <span className="text-blue-400 mr-2">•</span>
                          <span>{fact}</span>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}

                {reportData.strongInferences && reportData.strongInferences.length > 0 && (
                  <section className="rounded-3xl border border-white/10 bg-white/5 p-6">
                    <h2 className="text-xl font-semibold mb-4 flex items-center">
                      <span className="w-2 h-2 bg-green-500 rounded-full mr-3"></span>
                      Strong Inferences
                    </h2>
                    <ul className="space-y-2">
                      {reportData.strongInferences.map((inference, index) => (
                        <li key={index} className="text-zinc-300 flex items-start">
                          <span className="text-green-400 mr-2">•</span>
                          <span>{inference}</span>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}

                {reportData.weakInferences && reportData.weakInferences.length > 0 && (
                  <section className="rounded-3xl border border-white/10 bg-white/5 p-6">
                    <h2 className="text-xl font-semibold mb-4 flex items-center">
                      <span className="w-2 h-2 bg-yellow-500 rounded-full mr-3"></span>
                      Weak Inferences
                    </h2>
                    <ul className="space-y-2">
                      {reportData.weakInferences.map((inference, index) => (
                        <li key={index} className="text-zinc-300 flex items-start">
                          <span className="text-yellow-400 mr-2">•</span>
                          <span>{inference}</span>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}
              </div>

              <div className="space-y-6">
                {reportData.redFlags && reportData.redFlags.length > 0 && (
                  <section className="rounded-3xl border border-red-900/30 bg-red-950/10 p-6">
                    <h2 className="text-xl font-semibold mb-4 text-red-400 flex items-center">
                      <span className="w-2 h-2 bg-red-500 rounded-full mr-3"></span>
                      Red Flags
                    </h2>
                    <ul className="space-y-2">
                      {reportData.redFlags.map((flag, index) => (
                        <li key={index} className="text-zinc-300 flex items-start">
                          <span className="text-red-400 mr-2">•</span>
                          <span>{flag}</span>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}

                {reportData.greenFlags && reportData.greenFlags.length > 0 && (
                  <section className="rounded-3xl border border-green-900/30 bg-green-950/10 p-6">
                    <h2 className="text-xl font-semibold mb-4 text-green-400 flex items-center">
                      <span className="w-2 h-2 bg-green-500 rounded-full mr-3"></span>
                      Green Flags
                    </h2>
                    <ul className="space-y-2">
                      {reportData.greenFlags.map((flag, index) => (
                        <li key={index} className="text-zinc-300 flex items-start">
                          <span className="text-green-400 mr-2">•</span>
                          <span>{flag}</span>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}

                {reportData.missingInformation && reportData.missingInformation.length > 0 && (
                  <section className="rounded-3xl border border-yellow-900/30 bg-yellow-950/10 p-6">
                    <h2 className="text-xl font-semibold mb-4 text-yellow-400 flex items-center">
                      <span className="w-2 h-2 bg-yellow-500 rounded-full mr-3"></span>
                      Missing Information
                    </h2>
                    <ul className="space-y-2">
                      {reportData.missingInformation.map((item, index) => (
                        <li key={index} className="text-zinc-300 flex items-start">
                          <span className="text-yellow-400 mr-2">•</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}

                {reportData.nextSteps && reportData.nextSteps.length > 0 && (
                  <section className="rounded-3xl border border-indigo-900/30 bg-indigo-950/10 p-6">
                    <h2 className="text-xl font-semibold mb-4 text-indigo-400 flex items-center">
                      <span className="w-2 h-2 bg-indigo-500 rounded-full mr-3"></span>
                      Next Steps
                    </h2>
                    <ul className="space-y-2">
                      {reportData.nextSteps.map((step, index) => (
                        <li key={index} className="text-zinc-300 flex items-start">
                          <span className="text-indigo-400 mr-2">•</span>
                          <span>{step}</span>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}

                {reportData.longTermOutlook && (
                  <section className="rounded-3xl border border-purple-900/30 bg-purple-950/10 p-6">
                    <h2 className="text-xl font-semibold mb-4 text-purple-400 flex items-center">
                      <span className="w-2 h-2 bg-purple-500 rounded-full mr-3"></span>
                      Long-term Outlook
                    </h2>
                    <div className="space-y-3">
                      <div className="flex items-start">
                        <span className="text-purple-400 font-medium w-24 flex-shrink-0">1 Year:</span>
                        <span className="text-zinc-300">{reportData.longTermOutlook.oneYear}</span>
                      </div>
                      <div className="flex items-start">
                        <span className="text-purple-400 font-medium w-24 flex-shrink-0">5 Years:</span>
                        <span className="text-zinc-300">{reportData.longTermOutlook.fiveYears}</span>
                      </div>
                      <div className="flex items-start">
                        <span className="text-purple-400 font-medium w-24 flex-shrink-0">20 Years:</span>
                        <span className="text-zinc-300">{reportData.longTermOutlook.twentyYears}</span>
                      </div>
                    </div>
                  </section>
                )}
              </div>
            </div>

            {!reportData.observedFacts?.length && !reportData.strongInferences?.length && !reportData.weakInferences?.length && !reportData.redFlags?.length && !reportData.greenFlags?.length && !reportData.missingInformation?.length && !reportData.nextSteps?.length && !reportData.longTermOutlook && (
              <div className="mt-8 rounded-3xl border border-white/10 bg-white/5 p-8 text-zinc-400">
                No detailed report data available.
              </div>
            )}
          </div>
        )}
      </div>
    </main>
  );
}
